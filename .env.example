# Automated Red-Team Harness - Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://redteam:redteam_secret@localhost:5432/redteam_db

# ── Anthropic (Claude LLM Judge) ─────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_JUDGE_ENABLED=false

# ── GitHub (Auto-filing findings) ────────────────────────
GITHUB_TOKEN=your-github-pat-here
GITHUB_REPO=your-username/your-repo
GITHUB_ENABLED=false

# ── Target Applications ──────────────────────────────────
RAG_TARGET_URL=http://localhost:8001/api/chat
AGENT_TARGET_URL=http://localhost:8002/api/chat

# ── Runner Configuration ─────────────────────────────────
MAX_CONCURRENCY=5
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60
RUN_TIMEOUT_SECONDS=30

# ── Scheduler ────────────────────────────────────────────
SCHEDULED_RUN_CRON=0 2 * * *
SCHEDULER_ENABLED=false

# ── API ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Authentication (API keys) ────────────────────────────
# All endpoints except /api/health require a key when enabled.
AUTH_ENABLED=true
# Comma-separated SHA-256 hashes of accepted keys. NEVER put raw keys here.
# Generate one:  python -m src.api.security --generate
API_KEY_HASHES=

# ── CORS ─────────────────────────────────────────────────
# Exact browser origins allowed to call the API cross-origin (comma-separated),
# e.g. https://your-dashboard.vercel.app. Empty = same-origin only. '*' is
# rejected while AUTH_ENABLED=true.
CORS_ALLOW_ORIGINS=
